### Brief: key ( database key )
# Name of a portrait type group from common/portrait_types (e.g. human).
# Defines how portraits of that group can be customized in the ruler designer and the barbershop.
# Every portrait type group must have an entry; missing entries and keys that are not portrait type groups log an error.
#
key = {
	### Brief: default_age ( int )
	# Age set on the character when the ruler designer character is reset.
	# Default: 0
	#
	default_age = 25

	### Brief: min_age_for_sexuality ( int )
	# Minimum age in the ruler designer at which the sexuality can be changed.
	# Default: 0
	#
	min_age_for_sexuality = 10

	### Brief: modifier_overrides ( list of portrait modifier group = portrait modifier pairs )
	# Portrait modifiers (from gfx/portraits/portrait_modifiers) that are forced on ruler designer portraits.
	# Each entry is 'group = modifier'; the same group can be listed several times.
	# An entry is only applied if the modifier's weight evaluates to > 0.
	#
	# Supported scopes (weight):
	#	root: not set (no character)
	#	scope:culture ( culture )
	#	scope:female ( bool )
	#	scope:ruler_designer ( bool, always yes )
	#	scope:current_weight ( value )
	#	scope:weight_for_portrait ( value )
	#	scope:prowess ( value, scaled for portraits )
	#
	modifier_overrides = {
		weight = ruler_designer_overweight
		weight = ruler_designer_underweight
	}

	### Brief: accessories ( list of accessory gene = portrait modifier group pairs )
	# For each accessory gene, the portrait modifier group whose modifiers are offered as options for that gene in the ruler designer.
	# The gene must be an accessory gene (an error is logged otherwise).
	#
	accessories = {
		hairstyles = custom_hair
	}

	### Brief: sex_only_genes ( per sex list of genes )
	# Genes that are only shown for one sex in the ruler designer.
	# Keys: male, female, none. Only the 'female' list is currently used.
	#
	sex_only_genes = {
		female = { gene_bs_bust }
	}

	### Brief: hidden_slider_genes ( list of genes )
	# Morph genes whose slider is not shown in the ruler designer.
	#
	hidden_slider_genes = {
		gene_bs_body_type
	}

	### Brief: gene_groups ( block of categories )
	# Categories of gene groups shown as tabs in the ruler designer's appearance customization.
	# Each category is a block of 'group = camera' pairs:
	#	group: gene group name (matches the 'group' of genes); sets the open side tab.
	#	camera: portrait view to use when the group is selected.
	# Localization keys: RULER_DESIGNER_CATEGORY_<category> and RULER_DESIGNER_GROUP_<group>
	#
	gene_groups = {
		anatomy = {
			body = full_body
			face = face
		}
	}

	### Brief: color_genes ( color gene type = portrait modifier group pairs )
	# Portrait modifier group that gets the color picker for a color gene in the barbershop.
	# Keys: skin, eye, hair
	#
	color_genes = {
		hair = custom_hair
	}

	### Brief: accessory_color_override_block_0 ( portrait modifier group )
	# Portrait modifier group that gets the clothing color picker for accessory color override block 0 in the barbershop.
	# accessory_color_override_block_1, accessory_color_override_block_2 and accessory_color_override_block_3 work the same for blocks 1 - 3.
	# All four are required (an error is logged if one is missing).
	#
	accessory_color_override_block_0 = custom_clothes
}
