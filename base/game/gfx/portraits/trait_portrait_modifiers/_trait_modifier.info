group_name = { # The first that is valid will be applied, use this to have a priority order if need be
	entry = { # Name of entry
		traits = { # Must have one of these traits to get the modifier (optional, no trait requirement if not set)
			trait_1 trait_2
		}
		trigger = { # Trigger to be true for group to be used, root may be set as a character so exists check it if you are not using a global trigger, interface triggers are allowed
			<trigger>
		}
		base = another_entry # Will also apply the dna_modifiers of the base if this entry is applied, useful for reduced duplication
		dna_modifiers = {
			human = { # Portrait type group key (see common/portrait_types)
				# The dna modifiers
			}
		}
	}
}
