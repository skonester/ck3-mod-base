### Brief: key ( database key )
# Name of the coat of arms designer color palette.
# Read by the game's coat of arms designer only (CCoatOfArmsColorPaletteDatabase); the engine coat of arms system does not read this folder.
#
# Only the palette with the key 'coa_designer_background_colors' is used. It is required, and it defines the named colors
# offered by the color pickers in the coat of arms designer (both for the background pattern and for emblems).
# Other keys are loaded but not used.
#
key = {
	### Brief: <color name> ( named color key )
	# Each entry adds a color to the palette. The left-hand side must be the name of a color defined in 'common/named_colors'.
	# The right-hand side block is skipped; its contents are ignored.
	# Unknown color names are removed from the palette with an error.
	# Entries are shown in the order they are listed.
	#
	color_name = {}
}

## Example ##

coa_designer_background_colors = {
	red = {}
	white = {}
	black = {}
}
