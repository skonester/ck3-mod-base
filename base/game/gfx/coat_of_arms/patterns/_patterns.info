### Brief: key ( database key )
# File name (with extension) of a pattern texture in this folder, e.g. pattern_solid.dds
#
# Engine vs. designer data:
#	- The engine coat of arms system only uses the texture files in this folder. A coat of arms 'pattern = "file.dds"'
#	  (and entries in 'pattern_texture_lists' in common/coat_of_arms/template_lists) are resolved as
#	  gfx/coat_of_arms/patterns/<file>. The engine does not read the .txt files in this folder.
#	- The .txt files are read only by the game's coat of arms designer (CCoatOfArmsDesignerPatternDatabase),
#	  and define which patterns are listed in the designer's background panel, and how many colors each uses.
#
# Visible entries are listed in the designer in database order (file order).
# A pattern used by a coat of arms that has no entry here is treated as having the default values below.
#
key = {
	### Brief: colors ( int )
	# How many color options the designer shows for this pattern.
	# Allowed range: 0 - 5. Out of range values log an error and are set to 5.
	# Default: 5
	#
	colors = 2

	### Brief: visible ( bool )
	# Whether the pattern is listed in the designer.
	# Use 'visible = no' to only specify the number of colors for a pattern that can appear on a coat of arms edited in the designer
	# without making it selectable.
	# Default: yes
	#
	visible = yes/no
}

## Example ##

pattern_solid.dds = { colors = 1 visible = no }
pattern_horizontal_split_01.dds = { colors = 2 }
