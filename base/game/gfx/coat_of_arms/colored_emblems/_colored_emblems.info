### Brief: key ( database key )
# File name (with extension) of a colored emblem texture in this folder, e.g. ce_lis.dds
#
# Engine vs. designer data:
#	- The engine coat of arms system only uses the texture files in this folder. A coat of arms 'colored_emblem = { texture = "file.dds" }'
#	  (and entries in 'colored_emblem_texture_lists' in common/coat_of_arms/template_lists) are resolved as
#	  gfx/coat_of_arms/colored_emblems/<file>. The engine does not read the .txt files in this folder.
#	- The .txt files are read only by the game's coat of arms designer (CCoatOfArmsDesignerEmblemTextureDatabase),
#	  and define which emblems are listed in the designer, in which category, and how many colors each uses.
#
# Within a category, visible entries are listed in database order (file order).
# An emblem used by a coat of arms that has no entry here is treated as having the default values below.
# The 'count_unique_emblem_colors' console command can generate the 'colors' values (it does not preserve 'visible').
#
key = {
	### Brief: colors ( int )
	# How many color options the designer shows for this emblem.
	# Allowed range: 0 - 3. Out of range values log an error and are set to 3.
	# Default: 3
	#
	colors = 1

	### Brief: visible ( bool )
	# Whether the emblem is listed in the designer.
	# Use 'visible = no' to only specify the number of colors for an emblem that can appear on a coat of arms edited in the designer
	# without making it selectable.
	# Default: yes
	#
	visible = yes/no

	### Brief: category ( string )
	# The designer category (dropdown tab) this emblem is listed under. Any string; the categories are the unique values
	# used by visible entries, sorted alphabetically.
	# Localization key: COA_DESIGNER_CATEGORY_<category>
	# Required for visible entries (an error is logged if missing).
	#
	category = animals
}

## Example ##

ce_lis.dds = { colors = 1 category = abstract }
ce_hidden_example.dds = { colors = 2 visible = no }
