### Brief: key ( database key )
# Name of a coat of arms designer emblem layout.
# Read only by the game's coat of arms designer (CCoatOfArmsDesignerEmblemLayoutDatabase); the engine coat of arms system does not read this folder.
# Layouts are listed in the designer's emblem layout panel in database order (file order).
#
# The body is parsed with the engine's coat of arms reader, so it uses the same format as a coat of arms in
# common/coat_of_arms/coat_of_arms. Only the fields documented below are used by the designer.
# Selecting a layout replaces the colored emblems of the coat of arms being edited with the layout's colored emblems
# (texture, colors and instances); the background of the edited coat of arms is kept.
#
key = {
	### Brief: pattern ( pattern texture file name )
	# Pattern texture in gfx/coat_of_arms/patterns.
	# Only used for the layout's thumbnail preview until the previews are refreshed from the coat of arms being edited.
	# It is not applied when the layout is selected.
	#
	pattern = "pattern_solid.dds"

	### Brief: color1 ( coat of arms color )
	# Background color, as a named color from common/named_colors or a color value. color2 - color5 are read the same way.
	# Same usage as 'pattern': thumbnail preview only.
	#
	color1 = grey

	### Brief: colored_emblem ( block, repeatable )
	# A colored emblem. Each instance of each colored emblem becomes one emblem instance in the designer.
	#
	colored_emblem = {
		### Brief: texture ( colored emblem texture file name )
		# Emblem texture in gfx/coat_of_arms/colored_emblems.
		#
		texture = "ce_fleur.dds"

		### Brief: color1 ( coat of arms color )
		# Emblem color, as a named color from common/named_colors or a color value. color2 and color3 are read the same way.
		# Color references to the background colors (e.g. 'color1 = color2') are parsed but not resolved for layouts,
		# so the emblem color stays unset; use a color name or value instead.
		#
		color1 = white

		### Brief: instance ( block, repeatable )
		# Placement of one copy of the emblem.
		#
		instance = {
			### Brief: position ( 2D vector )
			# Position, in 0-1 coordinates of the coat of arms.
			# Default: { 0.5 0.5 }
			#
			position = { 0.5 0.5 }

			### Brief: scale ( 2D vector )
			# Scale of the emblem.
			# Default: { 1 1 }
			#
			scale = { 1 1 }

			### Brief: rotation ( int )
			# Rotation in degrees.
			# Default: 0
			#
			rotation = 0

			### Brief: depth ( float )
			# Layering order of the instance; instances with a higher depth are further back.
			# If no instance in the layout sets a depth, file order is used instead (earlier instances are further back).
			# The designer renumbers depths after loading, so only the relative order matters.
			# Default: 0.01
			#
			depth = 1
		}
	}
}

## Notes ##
# The coat of arms reader also accepts other coat of arms fields, such as 'sub', 'instance' (render description level),
# 'textured_emblem' and colored_emblem 'mask'. These are not used when a layout is applied.
# A layout with a 'sub' block logs an error, since a layout can only be one render description.

## Example ##

coa_designer_diagonal_duo = {
	pattern = "pattern_solid.dds"
	color1 = grey

	colored_emblem = {
		texture = "ce_fleur.dds"
		color1 = white
		instance = { position = { 0.3 0.3 }  scale = { 0.4 0.4 } }
		instance = { position = { 0.7 0.7 }  scale = { 0.4 0.4 } }
	}
}
