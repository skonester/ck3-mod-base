Example usage of HUD skins

key = { # The key *MUST* correspond to the "name" parameter of the .skin file (in gfx/skins)

	# Trigger to determine if this skin is available at all (e.g. DLC checks). Unavailable skins are not listed in the
	# settings and are never applied; a selected unavailable skin falls back to "default".
	# Scope: none
	is_valid = { <trigger> }

	# Trigger can be used to determine what skin should be shown based on conditions
	# Scope: player character
	is_shown = { <trigger> }
}
