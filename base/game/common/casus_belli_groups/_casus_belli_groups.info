### Brief: key ( database key )
# Name of 'casus_belli_group'
# A group that casus belli types belong to through their 'group' field (see ../casus_belli_types/_casus_belli.info).
# The group adds restrictions and flags shared by every casus belli in it.
# The groups 'religious' and 'de_jure' are referenced by code and must exist:
#	religious: used to find holy wars (e.g. counting the holy wars of a faith)
#	de_jure: skipped in one of the AI casus belli searches, since de jure targets are handled separately
#
key = {
	### Brief: allowed_for_character ( optional trigger )
	# Must be true for the attacker to use any casus belli in this group.
	# Evaluated together with, and before, the casus belli type's own 'allowed_for_character'.
	# Also re-checked when the primary attacker of an ongoing war changes.
	# Default: empty (always true)
	#
	# Supported scopes:
	#	root ( character ): the attacker
	#	scope:attacker ( character )
	#	scope:defender ( character ): may be unset depending on how the trigger is tested
	#	list target_titles ( landed titles ): only set when the targeted titles are known
	#
	allowed_for_character = {
		<triggers>
	}

	### Brief: should_invalidate ( optional trigger )
	# Checked for ongoing wars using a casus belli of this group. If true, the war is invalidated.
	# Evaluated before the casus belli type's own 'should_invalidate'; either being true invalidates the war.
	# Default: empty (never invalidates)
	#
	# Supported scopes:
	#	root ( casus belli ): the war's casus belli
	#	scope:attacker ( character ): the primary attacker
	#	scope:defender ( character ): the primary defender
	#	scope:claimant ( character ): may be unset
	#	scope:war ( war )
	#	list target_titles ( landed titles )
	#	list attackers ( characters ): all attackers, including the primary attacker
	#	list defenders ( characters ): all defenders, including the primary defender
	#
	should_invalidate = {
		<triggers>
	}

	### Brief: can_only_start_via_script ( optional bool )
	# If yes, casus bellis in this group are never offered in the declare war interface nor used by the AI,
	# and can only be started from script.
	# Default: no
	#
	can_only_start_via_script = yes/no

	### Brief: should_check_for_interface_availability ( optional bool )
	# If no, casus bellis in this group are skipped when the interface checks whether any casus belli
	# is available against a character.
	# Does not affect the AI or the war declaration logic itself.
	# Default: yes
	#
	should_check_for_interface_availability = yes/no

	### Brief: debug ( optional bool )
	# Marks the group as a debug/test group. The AI never picks casus bellis from it when looking for wars.
	# Does not hide the casus bellis from players.
	# Default: no
	#
	debug = yes/no
}
