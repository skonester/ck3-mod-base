### Brief: key ( database key )
# Name of 'bookmark_portrait'
# Stored portrait data used for bookmark characters, challenge characters and the main menu scene.
# Bookmark characters look up the portrait with the same key as their name ( error logged if missing ).
#
# These files are generated, not written by hand. Start a game at the bookmark date and use the console commands:
#	dump_bookmark_portraits								Writes <character name key>.txt for every bookmark
#														( and challenge ) character starting on the current date
#	dump_bookmark_portrait_for <historical id> ...		Writes historical_export_<historical id>.txt for the given characters
# Output is written to the user directory and must be copied into this folder.
#
# The portrait data is only read when graphics are running; otherwise the entries are skipped.
#
key = {
	### Brief: type ( portrait type key )
	# Portrait type, e.g. male, female, boy, girl. Must come before genes.
	#
	type = male

	### Brief: id ( int )
	# Portrait id.
	#
	id = 11388

	### Brief: random_seed ( optional int )
	# Seed used for random portrait choices.
	# Default: the value of id
	#
	random_seed = 1720731513

	### Brief: age ( optional float )
	# Relative age of the portrait, in range [0, 1].
	# Default: 0
	#
	age = 0.58

	### Brief: genes ( block )
	# Gene values, one entry per gene key of the portrait type's gene group.
	# Color genes take four values, morph and accessory genes take template/value pairs for the dominant and recessive gene.
	# Error logged for unknown genes.
	#
	genes = {
		hair_color = { 175 203 175 203 }
		gene_chin_forward = { "chin_forward_pos" 135 "chin_forward_pos" 135 }
		hairstyles = { "catholic_devoted_hairstyles" 252 "all_hairstyles" 0 }
	}

	### Brief: override ( optional block )
	# Portrait overrides.
	#
	override = {
		### Brief: portrait_modifier_overrides ( optional block )
		# Forces portrait modifiers: <portrait modifier group> = <modifier key>
		#
		portrait_modifier_overrides = {
			custom_headgear = male_empty
		}

		### Brief: colors ( optional block )
		# Color overrides as RGB values in range [0, 1]. Supported keys: skin, eye, hair
		#
		colors = {
			hair = { 0.05 0.01 0 }
		}
	}

	### Brief: entity ( optional list of ints )
	# Entity state hashes.
	#
	entity = { 318571666 318571666 }

	### Brief: tags ( optional list of blocks )
	# Portrait tags, as hashes.
	#
	tags = {
		{
			hash = 2125534279
			invert = no
		}
	}
}
