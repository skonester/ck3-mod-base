### Defines a bookmark

bookmark_01 = {
	### Brief: start_date (date)
	# Which date this bookmark starts at
	# If not set, uses the 'default_start_date' of the bookmark's 'group'. Error if neither is set.
	start_date = 867.1.1
	
	### Brief: is_playable (yes/no)
	# Sets if this bookmark is playable or not
	# defaults to: yes
	is_playable = yes

	### Brief: weight (scriptable value)
	# Sets the weight for this bookmark to be the default bookmark
	# Bookmark with the highest value will be the default
	# Note that this is calculated before a gamestate exists and thus cannot use gamestate related triggers
	# Evaluated with an empty top scope (no root)
	# defaults value: -1
	weight = {
		value = 0
		if = {
			limit = { has_dlc = "The Fate of Iberia" }
			add = 20
		}
	}

	### Brief: test_default (yes/no)
	# Use this bookmark as the default when running tests. Only one bookmark should set this.
	# defaults to: no
	test_default = no

	### Brief: recommended (yes/no)
	# If bookmark should show as recommended or not
	# defaults to: no
	recommended = yes

	### Brief: group (bookmark_group key)
	# Set what group this bookmark is part of
	# left empty bookmark will be ungrouped
	group = bm_group_867

	### Brief: requires_dlc_flag (dlc feature flag)
	# Sets a DLC flag the must be active for this bookmark to show.
	# Not adding this will make the bookmark show regardless of active DLCs.
	requires_dlc_flag = legends_of_the_dead

	### Brief: character (block)
	# A bookmark character. Can be repeated.
	# The background image is gfx/interface/bookmarks/<bookmark key>.dds
	character = {
		### Brief: name (key)
		# Localization key for this bookmark
		# Also used for '<name>_desc' and '<name>_subheading' loc, the bookmark portrait lookup (bookmark_portraits),
		# and the location image gfx/interface/bookmarks/<bookmark key>_<name>.dds
		name = bookmark_test_1066_person_name

		### Brief: history_id (key)
		# Which historical character ID this bookmark corresponds to
		history_id = test_12345

		### Brief: character_design_type (default, landless_adventurer, noble_family, none)
		# What type of bookmark this character represents. 'none' is an existing historical character.
		# For the other types, the starting location 'title' needs to configured
		# defaults to: none
		character_design_type = none

		### Brief: relation (key)
		# Localization key describing the relation to the parent bookmark character (used for nested 'character' blocks)
		relation = "BOOKMARK_RELATION_BROTHER"

		### Brief: difficulty (key)
		# Localization key for the difficulty. Error if not set.
		difficulty = "BOOKMARK_CHARACTER_DIFFICULTY_EASY"

		### Brief: birth (date)
		# Birth date, used to show the character's age
		birth = 1030.1.1

		### Brief: type (portrait type key)
		# Portrait type, e.g. male or female
		type = male

		### Brief: title (landed title key)
		# The character's primary title
		title = k_england

		### Brief: target_title (landed title key)
		# Title to show as the target; used as the starting title if set. Either 'title' or 'target_title' must be set.
		target_title = h_china

		### Brief: title_text_override (key)
		# Localization key shown instead of the name of 'title'
		title_text_override = some_loc_key

		### Brief: culture (culture key)
		# The character's culture
		culture = english

		### Brief: religion (key)
		# Localization key for the religion shown
		religion = catholic

		### Brief: dynasty (dynasty key)
		# The character's dynasty
		dynasty = 12345

		### Brief: dynasty_house (dynasty house key)
		# The character's house. If set, the dynasty is taken from the house (and 'dynasty' is ignored).
		dynasty_house = house_test

		### Brief: dynasty_splendor_level (int)
		# Dynasty splendor level to show. Must be > 0 if the character has a dynasty.
		dynasty_splendor_level = 1

		### Brief: government (government type key)
		# The character's government. Error if not set.
		government = feudal_government

		### Brief: fallback_government (government type key)
		# Government used instead of 'government' if that one is DLC locked. Must not itself be DLC locked.
		fallback_government = feudal_government

		### Brief: position ({ x y })
		# Position of the character in the bookmark GUI
		position = { 100 200 }

		### Brief: animation (portrait animation key)
		# Portrait animation to use
		animation = personality_honorable

		### Brief: tutorial (yes/no)
		# If this character is available for the tutorial
		# defaults to: no
		tutorial = no

		### Brief: display (yes/no)
		# If this character should be displayed. If no, the location image is not required.
		# defaults to: yes
		display = yes

		### Brief: character (block)
		# A related character shown with this character, same format as this block. Can be repeated.
		character = { }
	}
}
