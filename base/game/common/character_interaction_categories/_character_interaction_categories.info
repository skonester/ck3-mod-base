### Brief: key ( database key )
# Name of 'character_interaction_category'
# A category grouping character interactions in the character interaction menu.
# Interactions pick their category with the 'category' field (see ../character_interactions/_character_interactions.info).
#
# Localization:
#	<key>: name of the category, localized with the target character available as CHARACTER
#
# Icons:
#	Icon: CHARACTER_INTERACTION_CATEGORY_ICON_PATH/<icon> (see 'icon' below)
#	Background: CHARACTER_INTERACTION_CATEGORY_BACKGROUND_PATH/<key>
#
key = {
	### Brief: index ( int )
	# Position of the category in the interaction menu. Required.
	# Indices must be unique and start at 0 without gaps; a gap logs an error.
	# A missing or negative index logs an error.
	# If two categories share an index, an error is logged and the one read last is used.
	#
	index = 0

	### Brief: desc ( optional localization key )
	# Localization key for the description of the category.
	# Default: empty
	#
	desc = "LOC_KEY"

	### Brief: color ( optional color )
	# Color of the category in the interface.
	#
	color = { 1 1 1 1 }

	### Brief: icon ( optional string )
	# Icon file name, without file ending, in CHARACTER_INTERACTION_CATEGORY_ICON_PATH.
	# Does not fall back to the category key when not set.
	#
	icon = "filename"

	### Brief: default ( optional bool )
	# If yes, interactions without a scripted category are put in this category.
	# Exactly one category must be the default: none, or more than one, logs an error (the first one read is kept).
	# Default: no
	#
	default = yes/no

	### Brief: favorite_interactions ( optional bool )
	# If yes, interactions marked as favorite by the player are also shown in this category.
	# Only one category can be the favorites category; more than one logs an error (the first one read is kept).
	# Default: no
	#
	favorite_interactions = yes/no
}

# Every category except the default and favorites categories logs an error if no interaction uses it.
