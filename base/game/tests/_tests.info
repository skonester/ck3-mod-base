### Brief: key ( database key )
# Name of 'scripted_test'
# Scripted tests run triggers and effects against the current game state and report pass/fail.
# Run with the console command: scripted_tests [pattern]
#	pattern ( optional ): only run tests whose key contains this string
# Tests also run automatically as part of the automated game test.
# Results are reported under the test class ScriptedTests.<file path relative to tests/, '.' for folders>.
#
# Each test runs with a fixed random seed ( 1337 ). Parts ( assert, effect, expect ) run in the order they are written.
# Triggers and effects are not validated against a scope type when read.
#
key = {
	### Brief: name ( optional string )
	# Ignored.
	#
	name = "my_test"

	### Brief: character_target ( optional history character id )
	# Sets root to this history character. Takes precedence over title_target.
	# Root is left unset if the character doesn't exist.
	#
	character_target = 73318

	### Brief: title_target ( optional landed title key )
	# Sets root to this landed title.
	# Root is left unset if the title doesn't exist.
	#
	title_target = k_croatia

	### Brief: target ( optional block, repeatable )
	# Saved scope available to all parts of the test as scope:<flag>.
	#
	target = {
		### Brief: flag ( key )
		# Name of the saved scope.
		#
		flag = harold

		### Brief: character_target ( optional history character id )
		# The saved scope is this history character. Takes precedence over title_target.
		#
		character_target = 122

		### Brief: title_target ( optional landed title key )
		# The saved scope is this landed title.
		#
		title_target = k_persia
	}

	### Brief: assert ( trigger, repeatable )
	# Test fails if the trigger is false, and the remaining parts of the test are skipped.
	#
	# Supported scopes:
	#	root ( character or landed title, from character_target / title_target )
	#	scope:<flag> for every target
	#
	assert = {
		<triggers>
	}

	### Brief: effect ( effect, repeatable )
	# Effect executed on the game state. Scopes saved with save_scope_as are available to later parts.
	# Characters killed by the effect are processed right after it.
	#
	# Supported scopes:
	#	root ( character or landed title, from character_target / title_target )
	#	scope:<flag> for every target
	#
	effect = {
		<effects>
	}

	### Brief: expect ( trigger, repeatable )
	# Test fails if the trigger is false. The remaining parts of the test still run.
	#
	# Supported scopes:
	#	root ( character or landed title, from character_target / title_target )
	#	scope:<flag> for every target
	#
	expect = {
		<triggers>
	}
}

# Note: effects change the actual game state, and a single daily and event tick is run after all tests have finished.
