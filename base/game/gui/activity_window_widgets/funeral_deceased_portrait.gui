widget = {
	name = "funeral_deceased_portrait"
	datacontext = "[Activity.MakeScope().Var( 'body_to_bury' ).Char]"
	allow_outside = yes

	size = { 120 170 }
	position = { 50 60 }

	hbox = {
		spacer = {
			alwaystransparent = yes
			visible = "[Activity.IsComplete]"
			size = { 440 0 }
		}

		vbox = {
			margin = { 5 5 }

			text_label_center = {
				text = "body_to_bury_for_host"
				max_width = 130
			}

			portrait_head = { }

			text_label_center = {
				text = "[Character.GetShortUINameNoTooltip]"
				align = center
				max_width = 130
				multiline = yes
			}
		}
	}
}

