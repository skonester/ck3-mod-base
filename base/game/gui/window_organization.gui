
window = {
	name = "organization_window"
	movable = yes
	layer = middle
	allow_outside = yes

	size = { 700 90% }

	datacontext = "[OrganizationWindow.GetOrganization]"

	using = Window_Movable
	using = title_view_window_side_pop_out
	using = Window_Decoration
	using = Window_Background

	vbox = {
		using = Window_Margins
		spacing = 5

		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "[Organization.GetName]"
			}

			blockoverride "button_close"
			{
				onclick = "[OrganizationWindow.Close]"
			}
		}

		text_multi = {
			text = "[Organization.GetDescription]"
			align = center
			autoresize = yes
			max_width = 500
		}

		vbox_character_list = {
			datacontext = "[OrganizationWindow.AccessMemberList]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "container_implementation" {
				fixedgridbox = {
					name = "characters_grid"
					datamodel = "[CharacterSelectionList.GetList]"
					visible = "[Not(CharacterSelectionList.IsBuildingList)]"
					addcolumn = 588
					addrow = 98

					item = {
						widget_organization_item = {
							datacontext = "[CharacterListItem.GetCharacter]"
							size = { 588 94 }
						}
					}
				}
			}
		}
	}

	window_character_filter = {
		datacontext = "[OrganizationWindow.AccessMemberList]"
		visible_at_creation = no

		blockoverride "addition_filter" {

			vbox_filter_group = {
				datacontext = "[CharacterSelectionList.GetCategory('politics_filter_category')]"
				layoutpolicy_horizontal = expanding

				blockoverride "filters" {
					filter_item = {
						datacontext = "[CharacterSelectionList.GetFilter('ruler_filter')]"
						layoutpolicy_horizontal = expanding
					}
					filter_item = {
						datacontext = "[CharacterSelectionList.GetFilter('government_filter')]"
						layoutpolicy_horizontal = expanding
					}
					filter_item = {
						datacontext = "[CharacterSelectionList.GetFilter('relation_filter')]"
						layoutpolicy_horizontal = expanding
					}
					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('dynasty_filter')]"
					}
				}
			}

			vbox_filter_group = {
				layoutpolicy_horizontal = expanding
				datacontext = "[CharacterSelectionList.GetCategory('personal_filter_category')]"

				blockoverride "filters" {
					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('culture_filter')]"
					}
					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('gender_filter')]"
					}
					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('health_filter')]"
					}
					filter_item = {
						layoutpolicy_horizontal = expanding
						datacontext = "[CharacterSelectionList.GetFilter('imprisoned_filter')]"
					}
				}
			}
		}
	}
}

types window_oranization
{
	type widget_organization_item = widget {
		hbox = {
			layoutpolicy_horizontal = expanding

			background = {
				using = Background_Area
			}

			vbox = {
				layoutpolicy_vertical = expanding

				portrait_head_small = {}

				expand = {}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				### Name & Skills
				hbox = {
					layoutpolicy_horizontal = expanding

					margin = { 5 2 }
					margin_right = 6

					background = {
						using = Background_Area_Dark

						margin_left = 7
					}

					text_single = {
						name = "name"
						layoutpolicy_horizontal = expanding
						
						text = "[Character.GetUINameNoTooltip]"
						autoresize = no
						using = Font_Size_Medium
						align = nobaseline
						fontsize_min = 14
						margin_right = 10
						max_width = 340
					}

					hbox_skills_grid = {}
				}

				### Age & Relation
				hbox = {
					layoutpolicy_horizontal = expanding
					margin_left = 5

					using = character_age_or_death_text

					blockoverride "list_layout" {}

					text_single = {
						name = "character_relation"
						layoutpolicy_horizontal = expanding
						raw_text = "|  [Character.GetRelationToString( GetPlayer )]"
						tooltip = "EXTENDED_RELATIONS_TOOLTIP"
						default_format = "#low"
						autoresize = no
						align = nobaseline
						visible = "[Character.HasRelationTo( GetPlayer )]"
						alwaystransparent = yes
					}

					expand = {
						visible = "[Not(Character.HasRelationTo( GetPlayer ))]"
					}
				}

				expand = {}

				### House, Rite, Culture & Traits
				hbox = {
					layoutpolicy_horizontal = expanding

					hbox = {
						margin_bottom = 2

						widget = {
							size = { 40 40 }

							coa_house_small = {
								datacontext = "[Character.GetHouse]"
								parentanchor = center
								scale = 0.6
							}
						}

						button_rite_icon = {
							datacontext = "[Character.GetRite]"
							size = { 35 35 }
						}
					}

					hbox = {
						datacontext = "[Character.GetCulture]"

						tooltipwidget = {
							culture_tooltip = {}
						}
						using = tooltip_se

						icon = {
							name = "culture"
							texture = "gfx/interface/icons/icon_culture.dds"
							size = { 30 30 }
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							max_width = 150
							align = center|nobaseline
							text = "CULTURE_LISTS_WINDOW"
						}
					}

					expand = {}

					# Traits
					hbox = {
						margin = { 5 0 }

						fixedgridbox = {
							name = "traits_grid_four"
							datamodel = "[CharacterListItem.GetTraits]"
							flipdirection = yes
							addcolumn = 30
							addrow = 28
							datamodel_wrap = 10
							maxverticalslots = 1

							item = {
								icon_trait = {
									visible = "[Trait.IsValid]"

									blockoverride "icon_size"
									{
										size = { 30 30 }
									}

									blockoverride "tooltip_placement"
									{
										using = tooltip_se
									}

									blockoverride "glow_radius"
									{
										glow_radius = 3
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
